    <!-- Painel do e-mail -->
    <string name="email_titulo">Pedidos por e-mail</string>
    <string name="email_explica">Use quando o computador e este celular não estiverem na mesma rede. O computador escreve o pedido na caixa de e-mail da loja e o celular lê de lá. O pedido chega embaralhado: só este celular consegue abrir os que forem dele, e nada é lido fora da caixa que você indicar.</string>
