    <string name="email_switch_label">Receber pedidos por e-mail</string>
    <string name="email_switch_ajuda">Desligue para pausar. Enquanto estiver ligado, o celular procura pedidos novos a cada 30 segundos, em qualquer rede (Wi-Fi da loja, em casa ou 4G).</string>
