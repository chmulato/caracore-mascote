<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/gaspar_mascote"
            android:contentDescription="@string/config_marca_mascote"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/email_titulo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/brand_header_text" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/email_explica" />

            <!-- Interruptor da ponte -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/email_card_switch" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/email_switch_label"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchEmailAtiva"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp" />
                </LinearLayout>

                <TextView
                    style="@style/HintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/email_switch_ajuda"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Dados da caixa -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email_card_dados" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/email_endereco_label"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/editEmailUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:hint="@string/email_endereco_hint"
                    android:importantForAutofill="no"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/email_senha_label"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="12dp" />

                <EditText
                    android:id="@+id/editEmailSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:hint="@string/email_senha_hint"
                    android:importantForAutofill="no"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/textEmailSenha"
                    style="@style/HintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/email_senha_nenhuma"
                    android:layout_marginTop="6dp" />

                <TextView
                    style="@style/HintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/email_senha_ajuda"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnEmailAvancado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/email_avancado_label"
                    android:layout_marginTop="10dp"
                    style="?android:attr/buttonBarButtonStyle" />

                <LinearLayout
                    android:id="@+id/emailAvancado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/email_entrada_label"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginTop="4dp">

                        <EditText
                            android:id="@+id/editEmailEntrada"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="textUri"
                            android:importantForAutofill="no" />

                        <EditText
                            android:id="@+id/editEmailEntradaPorta"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:inputType="number"
                            android:hint="@string/email_porta_padrao_entrada"
                            android:importantForAutofill="no" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/email_saida_label"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginTop="4dp">

                        <EditText
                            android:id="@+id/editEmailSaida"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="textUri"
                            android:importantForAutofill="no" />

                        <EditText
                            android:id="@+id/editEmailSaidaPorta"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:inputType="number"
                            android:hint="@string/email_porta_padrao_saida"
                            android:importantForAutofill="no" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/email_caixa_label"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="10dp" />

                    <EditText
                        android:id="@+id/editEmailCaixa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:hint="@string/email_caixa_hint"
                        android:importantForAutofill="no"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnEmailSalvar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/email_salvar"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Situacao -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email_card_estado" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textEmailEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:text="@string/email_estado_off" />

                <TextView
                    android:id="@+id/textEmailFila"
                    style="@style/HintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/email_fila_vazia"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnEmailTestar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/email_testar"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/textEmailTeste"
                    style="@style/BodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/btnEmailVoltar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/email_voltar"
                android:layout_marginTop="20dp"
                style="?android:attr/buttonBarButtonStyle" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
