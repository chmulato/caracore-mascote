<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <!-- Cabeçalho com a identidade do Gaspar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/gaspar_mascote"
            android:contentDescription="@string/config_marca_mascote"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_marca_titulo"
                android:textSize="22sp"
                android:textColor="@color/brand_header_text"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_marca_subtitulo"
                android:textSize="14sp"
                android:textColor="@color/brand_header_subtitle"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_marca_slogan"
                android:textSize="12sp"
                android:textColor="@color/brand_header_subtitle"
                android:alpha="0.9"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Controle: ponte de SMS -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/config_secao_controle" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/config_switch_label"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            style="@style/HintText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/config_switch_summary"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchAtivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnBateria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_btn_bateria"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Wi-Fi da loja -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_secao_wifi" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textWifiRede"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:text="@string/config_wifi_rede_nenhuma" />

                <TextView
                    style="@style/HintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_wifi_ajuda"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnWifiManage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_wifi_btn"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Confirmação pelo celular -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_secao_confirmacao" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textConfirmacaoStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_on"
                    android:text="@string/config_confirmacao_status_on" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/config_confirmacao_switch"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchConfirmacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp" />
                </LinearLayout>

                <TextView
                    style="@style/HintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_confirmacao_ajuda"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnConfirmacaoHistorico"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/config_confirmacao_btn_historico" />

                    <Button
                        android:id="@+id/btnConfirmacaoTeste"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/config_confirmacao_btn_teste" />
                </LinearLayout>
            </LinearLayout>

            <!-- Licença Premium -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_secao_licenca" />

            <LinearLayout
                android:id="@+id/cardStatusLicenca"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textStatusLicenca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:text="@string/config_licenca_inativa" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_numero_oficial_label"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="12dp" />

                <TextView
                    style="@style/HintText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_numero_oficial_ajuda"
                    android:layout_marginTop="4dp" />

                <EditText
                    android:id="@+id/editNumeroOficial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:hint="@string/config_numero_oficial_hint"
                    android:importantForAutofill="no"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnSalvarNumeroOficial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_numero_oficial_salvar"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnVerificarUsb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_btn_verificar_usb"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Gateway Wi-Fi (pareamento) -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_secao_gateway" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/editGatewaySecret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/config_gateway_hint"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <Button
                    android:id="@+id/btnGatewayStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_gateway_btn"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnSetupQr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_setup_qr_btn"
                    android:layout_marginTop="6dp"
                    style="?android:attr/buttonBarButtonStyle" />
            </LinearLayout>

            <!-- Backup do banco de dados -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_secao_backup" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textStatusBackupCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:text="@string/config_backup_status_nenhum" />

                <TextView
                    android:id="@+id/textDataHoraBackupCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"
                    android:text="@string/config_backup_data_hora_nd" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/panel_divider"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp" />

            <!-- Precisa de ajuda? -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_ajuda_titulo"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                style="@style/BodyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_ajuda_desc"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textVersao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="12sp"
                android:textColor="@color/text_hint" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
