# Copie para keystore.properties e preencha com os dados do seu keystore de release.
# Gere o keystore com: criar-keystore.bat   (usa o JDK do build, keytool nao precisa estar no PATH)
# Caminhos sao relativos ao diretorio android/ (ou absolutos).

storeFile=pdv-sms-release.keystore
storePassword=SUA_SENHA
keyAlias=pdv-sms
keyPassword=SUA_SENHA
