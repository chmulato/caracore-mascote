# ============================================================================
# GASPAR - MASCOTE CARA CORE - .GITIGNORE
# Stack: Python 3.10+ (Tkinter/Pillow) | PyInstaller | Inno Setup
#        Debian/AppImage | Android (Gradle 7.5 / AGP 7.4.2)
# Atualizado: 2026-11-12
# ============================================================================
# Regras por ferramenta. O detalhamento do app Android fica em
# android/.gitignore; as regras de segredo e artefato repetidas aqui são
# rede de segurança para quem roda os scripts a partir da raiz.

# ============================================================================
# SEGREDOS E CREDENCIAIS - NUNCA VERSIONAR
# ============================================================================
# O diretório inteiro é bloqueado (não apenas por sufixo), para que arquivos
# com nomes inesperados dentro dele também fiquem fora do repositório.
secrets/
credentials/
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
keystore.properties
.env
.env.*
!.env.example

# Exceção nominal da chave pública do canal de atualização do Gaspar. Não é
# segredo: vai dentro do pacote para o app conferir a assinatura. A privada
# continua barrada por `*.pem` e mora fora do repositório.
!assets/gaspar-update-public.pem

# ============================================================================
# PYTHON
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
*.egg-info/
.eggs/

# ============================================================================
# AMBIENTES VIRTUAIS E CONFIGURACAO LOCAL
# ============================================================================
.venv/
venv/
env/
ENV/
config.local.*
settings.local.*

# ============================================================================
# TESTES, COBERTURA E ANALISE ESTATICA
# ============================================================================
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/

# ============================================================================
# BUILD E EMPACOTAMENTO
# ============================================================================
# PyInstaller usa build/ e dist/; os .spec em packaging/ sao codigo-fonte
# (editados a mao) e continuam versionados.
build/
dist/
*.manifest
Output/
*.iss.bak

# Instaladores e executaveis gerados
*.exe
*.msi
*.msix
*.appx
*.appxbundle

# Pacotes Debian
*.deb
*.ddeb
*.changes
*.buildinfo
*.dsc

# AppImage
*.AppImage
*.AppImage.zsync
AppDir/
squashfs-root/

# ============================================================================
# ANDROID (rede de seguranca; detalhes em android/.gitignore)
# ============================================================================
android/.gradle/
android/local.properties
android/captures/
*.apk
*.aab
*.ap_
*.dex
*.hprof

# ============================================================================
# DADOS DE EXECUCAO E LOGS
# ============================================================================
*.log
logs/
cycle_log.txt

# ============================================================================
# EDITORES E IDEs
# ============================================================================
.vscode/
.idea/
*.iml
*.ipr
*.iws
out/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ============================================================================
# SISTEMA OPERACIONAL
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ============================================================================
# COPIAS DE SEGURANCA E ARQUIVOS TEMPORARIOS
# ============================================================================
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.rej

# ============================================================================
# NOTEBOOKS E BANCOS LOCAIS
# ============================================================================
.ipynb_checkpoints/
*.db
*.sqlite
*.sqlite3

# ============================================================================
# MATERIAIS LOCAIS DE TRABALHO
# ============================================================================
# Imagens geradas para estudo de estilo; nao fazem parte do produto.
vibe_images/
